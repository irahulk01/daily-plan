generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Project {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  color       String?
  status      String    @default("Planning") // Planning, Active, On Hold, Completed, Archived
  priority    String    @default("Medium")
  startDate   DateTime?
  targetDate  DateTime?
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String?   @db.ObjectId
  title             String
  description       String?
  status            String    @default("Todo") // Inbox, Todo, In Progress, Blocked, Completed, Cancelled
  priority          String    @default("Medium") // None, Low, Medium, High, Urgent
  dueDate           DateTime?
  startTime         DateTime?
  endTime           DateTime?
  estimatedDuration Int?      // in minutes
  actualDuration    Int?      // in minutes
  isImportant       Boolean   @default(false)
  isArchived        Boolean   @default(false)
  tags              String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subtasks          Subtask[]
}

model Subtask {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  title     String
  completed Boolean  @default(false)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Routine {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String?
  recurringRule String   // e.g., 'Daily', 'Weekdays', 'Weekly'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Idea {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String?
  color       String?  @default("lime")
  category    String?  @default("Idea")
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
